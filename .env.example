# Copy to .env (never commit .env). All values are read from the environment.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tta:tta_dev_password@localhost:5432/tta
# Separate database for the test suite (it is wiped on every run)
TEST_DATABASE_URL=postgres://tta:tta_dev_password@localhost:5432/tta_test
AUTO_MIGRATE=true
# Production: true behind HTTPS. Cookies get the Secure flag and __Host- prefix.
SECURE_COOKIES=false
TRUST_PROXY=false
SESSION_HOURS=12
# Pilot switches (safe defaults)
PILOT_FREE_ACCESS=true
PILOT_WAIVE_FEES=true
# Only true once a contracted registry/verification provider integration is live
VERIFICATION_PROVIDER_LIVE=false
# Only 'simulated' is implemented. No payment is ever taken.
BILLING_PROVIDER=simulated
MAX_UPLOAD_BYTES=8388608
ALLOW_DEMO_SEED=true
DEMO_PASSWORD=DemoTrade2026
RATE_AUTH_PER_MIN=10
RATE_API_PER_MIN=600
